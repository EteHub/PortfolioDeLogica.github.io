<div class="content">
  <h1>La Lógica: La base del analisis racional.</h1>
</div>
<style>
  .content {
    position: absolute;
    top: 20%;
    width: 100%;
    /*transform: translate(-50%, -80%);*/
    text-align: center;
    font-family:
      "Inter",
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
    z-index: 1000;
    animation: fadeInUp 1s ease-out forwards;
  }
  @keyframes fadeInUp {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  h1 {
    font-family: "Montserrat";
    font-size: 3rem;
    font-weight: 800;
    margin: 0;  
  }

  @media (max-width: 780px) {
    h1 {
      transform: translate(50%, -10%);
      font-size: 2rem;
      padding: 0 20px;
    }
    .content {
      top: 45%;
      transform: translate(0%, -120px);
    }
    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translate(-50%, -40%);
      }
      to {
        opacity: 1;
        transform: translate(-50%, -100px);
      }
    }
  }
  @media (max-width: 310px) {
    h1 {
      transform: translate(50%, 130%);
      font-size: 10px;
      padding: 0 20px;
    }
    .content {
      top: 45%;
      transform: translate(0%, -120px);
    }
    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translate(-50%, -40%);
      }
      to {
        opacity: 1;
        transform: translate(-50%, -100px);
      }
    }
  }
    @media (max-width: 998px) {
    h1 {
      top: 0px;
      font-size: 30px;
    }
  }
</style>
<style>
  @keyframes fadeOut {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }
</style>
