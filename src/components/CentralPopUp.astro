<div class="content">
  <h1>La Lógica: La base del analisis racional.</h1>
</div>
<style>
  .content {
    position: fixed;
    top: 25%;
    left: 50%;
    width: 100%;
    transform: translate(-50%, -80%);
    text-align: center;
    color: #ffffff;
    font-family:
      "Inter",
      -apple-system,
      BlinkMacSystemFont,
      "Segoe UI",
      sans-serif;
    z-index: 1000;
    animation: fadeInUp 1s ease-out forwards;
  }
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translate(-50%, -40%);
    }
    to {
      opacity: 1;
    }
  }
  h1 {
    font-family: "Montserrat";
    font-size: 3rem;
    font-weight: 300;
    margin: 0;
    color: #b853f3;
    text-shadow: 0 2px 4px rgb(0, 0, 0);
  }

  @media (max-width: 780px) {
    h1 {
      font-size: 2rem;
      padding: 0 20px;
      transform: translate(0%, 35%);
    }
    .content {
      position: absolute;
      top: 45%;
      transform: translate(-50%, -50%);
    }
    @keyframes fadeInUp {
      from {
        opacity: 0;
        transform: translate(-50%, -40%);
      }
      to {
        opacity: 1;
        transform: translate(-50%, -100px);
      }
    }
  }
</style>
<style>
  @keyframes fadeOut {
    from {
      opacity: 1;
    }
    to {
      opacity: 0;
    }
  }
</style>
