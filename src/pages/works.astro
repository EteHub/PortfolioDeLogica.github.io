---
import NavBar from "../components/NavBar.astro";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!--<link rel="icon" type="image/svg+xml" href="/favicon.svg" />-->
    <link rel="icon" href="/logic.png" />
    <meta name="generator" content={Astro.generator} />
    <title>Trabajos - Portfolio Lógica</title>
  </head>
  <body>
    <NavBar />
    <h1 class="centered">Interesado en nuestros trabajos?</h1>
    <p class="centered">
      Acá podras encontrar informacion sobre nuestros trabajos, proyectos, etc
    </p>
    <div class="submodule-card">
      <h2>Submodulo 1</h2>
      <p>Descripcion del submodulo 1</p>
      <div class="works-cointainer"></div>
    </div>
  </body>
</html>
<style>
  @import url("https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap");
  @import url("https://fonts.googleapis.com/css2?family=Google+Sans:ital,opsz,wght@0,17..18,400..700;1,17..18,400..700&display=swap");
  html,
  body {
    margin: 0;
    padding: 0;
    font-family: "Montserrat", sans-serif;
    background-color: #0b0b0b;
    background-image: url("/w5.jpg");
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    background-attachment: fixed;
    min-height: 100vh;
    color: white;
  }
  .centered {
    display: flex;
    flex-direction: column;
    margin: 0 auto;
    text-align: center;
    padding: 20px;
    /*background: rgba(204, 21, 21, 0.5);*/
  }
  h1 {
    animation: fadeInUp 1s ease-out forwards;
    color: #ab2ef3;
    font-weight: 300;
    font-size: 3.5rem;
  }
  p {
    animation: fadeInUp 1s ease-out forwards;
  }
  @keyframes fadeInUp {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  .submodule-card {
    background: rgba(255, 255, 255, 0.075);
    border-radius: 8px;
    padding: 20px;
    margin: 20px auto;
    max-width: 90%;
    backdrop-filter: blur(10px);
    box-shadow: 0 0 10px rgb(0, 0, 0);
    text-align: center;
  }
  .submodule-card h2 {
    margin-top: 0;
    color: #ab2ef3;
    font-weight: 400;
  }
  .submodule-card p {
    color: #e0e0e0;
    font-weight: 300;
  }
  .works-cointainer {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 20px;
    margin-top: 20px;
  }
  @media (max-width: 768px) {
    h1 {
      font-size: 2.5rem;
    }
    .submodule-card {
      padding: 15px;
      margin: 15px auto;
      width: 350px;
    }
  }
</style>
