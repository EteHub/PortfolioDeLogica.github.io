  function openLinks(event: any, url1: string, url2: string) {
    // Evitamos el comportamiento por defecto del link
    event.preventDefault();

    // Abre el primer enlace (el que estaba en el href)
    window.open(url1, "_blank");

    // Abre el segundo enlace
    window.open(url2, "_blank");
  }
