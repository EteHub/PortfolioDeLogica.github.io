---
import NavBar from "../components/NavBar.astro";
---

<html lang="en">
  <head>
    <link rel="preload" href="/w5.jpg" as="image" />
    <link
      rel="preload"
      href="/Fonts/Montserrat-Regular.ttf"
      as="font"
      type="font/ttf"
      crossorigin="anonymous"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200&icon_names=visibility"
    />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <!--<link rel="icon" type="image/svg+xml" href="/favicon.svg" />-->
    <link rel="icon" href="/logic.png" />
    <meta name="generator" content={Astro.generator} />
    <title>Trabajos - Portfolio Lógica</title>
  </head>
  <body>
    <NavBar />
    <h1 class="centered">Interesado en nuestros trabajos?</h1>
    <p class="centered">
      Acá podras encontrar informacion sobre nuestros trabajos, proyectos, etc
    </p>
    <div class="submodule-card">
      <h2>modulo 1</h2>
      <p>una descripcion breve del modulo 1</p>
      <div class="works-cointainer">
        <div class="work-card">
          <h1>Trabajo 1</h1>
          <div class="work-card-photo-slot"></div>
          <p>hola</p>
          <button class="cls-btn-mdl"
            ><span class="material-symbols-outlined centered-button-content"
              >visibility</span
            >Ver Documento</button
          >
        </div>
        <div class="work-card">
          <h1>Trabajo 1</h1>
          <div class="work-card-photo-slot"></div>
          <p>
            descripcion corta del trabajo, con un maximo de 3 lineas, para que
            se vea bien en la card, si es mas largo se cortara y se mostrara un
            scrollbar para ver el resto del texto, pero lo ideal es que no sea
            tan largo para que se vea bien en la card
          </p>
          <button class="cls-btn-mdl">
            <span class="material-symbols-outlined centered-button-content"
              >visibility</span
            >
            Ver Documento
          </button>
        </div>
      </div>
    </div>
  </body>
</html>
<style>
  @import url("https://fonts.googleapis.com/css2?family=Google+Sans:ital,opsz,wght@0,17..18,400..700;1,17..18,400..700&display=swap");
  @font-face {
    font-family: "Montserrat";
    src: url("/Fonts/Montserrat-Regular.ttf") format("truetype");
    font-weight: 200; /* Normal */
    font-style: normal;
    font-display: swap;
  }
  /*@import url("https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap");*/
  html,
  body {
    margin: 0;
    padding: 0;
    font-family: "Montserrat", sans-serif;
    background-color: #0b0b0b;
    background-image: url("/w5.jpg");
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
    background-attachment: fixed;
    min-height: 100vh;
    color: white;
  }
  .centered {
    display: flex;
    flex-direction: column;
    margin: 0 auto;
    text-align: center;
    padding: 20px;
    /*background: rgba(204, 21, 21, 0.5);*/
  }
  .centered-button-content {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    size: 9.2rem;
  }
  /* boton al a parte inferior de la card siempre*/
  .cls-btn-mdl {
    font-family: "Google Sans", sans-serif;
    font-size: 1rem;
    width: 100%;
    background: transparent;
    color: white;
    border: 1px solid rgba(172, 172, 172, 0.404);
    padding: 10px 20px;
    border-radius: 5px;
    cursor: pointer;
    margin-top: auto;
    display: flex;
    align-items: center; /* Alinea verticalmente */
    justify-content: center; /* Alinea horizontalmente */
    gap: 8px;
    &:hover {
      background: rgb(160, 43, 140);
      border: none;
      color: #ffffff;
      transition: all 0.3s ease;
    }
  }
  .work-card h1 {
    color: #ab2ef3;
    font-weight: 400;
    font-size: 1.5rem;
    margin-top: 0;
  }
  .work-card p {
    word-break: break-word;
    margin-bottom: 15px;
    overflow-y: auto;
    flex-grow: 1;
    /* Estilo para el scrollbar opcional para que se vea mejor */
    &::-webkit-scrollbar {
      width: 4px;
    }
    &::-webkit-scrollbar-thumb {
      background: rgba(171, 46, 243, 0.3);
      border-radius: 10px;
    }
  }
  .work-card-photo-slot {
    width: 100%;
    height: 180px;
    background: rgba(255, 255, 255, 0.068);
    border-radius: 8px;
    margin-bottom: 10px;
    box-shadow: 0 0 10px rgb(0, 0, 0);
    flex-shrink: 0;
  }
  h1 {
    animation: fadeInUp 1s ease-out forwards;
    color: #ab2ef3;
    font-weight: 300;
    font-size: 3.5rem;
  }
  p {
    animation: fadeInUp 1s ease-out forwards;
  }
  @keyframes fadeInUp {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  .work-card {
    border: 1px solid rgba(171, 46, 243, 0.3);
    background: rgba(255, 255, 255, 0.068);
    border-radius: 8px;
    padding: 15px;
    color: #e0e0e0;
    font-weight: 300;
    width: 18rem;
    height: 400px;
    box-shadow: 0 0 10px rgb(0, 0, 0);
    cursor: pointer;
    display: flex;
    flex-direction: column;
  }
  .work-card p {
    font-size: 0.9rem;
    /* Estilo para el scrollbar opcional para que se vea mejor */
  }
  .submodule-card {
    background: rgba(255, 255, 255, 0.068);
    border-radius: 8px;
    padding: 20px;
    margin: 20px auto;
    max-width: 90%;
    backdrop-filter: blur(10px);
    box-shadow: 0 0 10px rgb(0, 0, 0);
    text-align: center;
  }
  .submodule-card h2 {
    margin-top: 0;
    color: #ab2ef3;
    font-weight: 400;
  }
  .submodule-card p {
    color: #e0e0e0;
    font-weight: 300;
  }
  .works-cointainer {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 20px;
    margin-top: 20px;
  }
  @media (max-width: 768px) {
    h1 {
      font-size: 2.5rem;
    }
    .submodule-card {
      padding: 15px;
      margin: 15px auto;
      width: 350px;
    }
  }
</style>
