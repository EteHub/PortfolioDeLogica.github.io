    .modal-grupo-trabajos {
      /* Reseteo para quitar estilos por defecto del navegador */
      margin: 0;
      padding: 20px;
      border: 1px solid #000000;

      /* Centrado forzado */
      position: fixed;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);

      /* Tamaño y forma */
      width: 50%;
      max-width: 300px;
      max-height: 80vh;
      border-radius: 12px;
      background: #1a1a1a;
      z-index: 99999;
      text-align: center;

      /* Importante: para que sea interactuable */
      display: flex;
      flex-direction: column;
    }

    /* Oscurece el fondo cuando se abre */
    .modal-grupo-trabajos::backdrop {
      background: rgba(0, 0, 0, 0.8);
    }

    .modal-content {
      display: flex;
      flex-direction: column;
      height: 100%;
    }

    .modal-actions {
      margin-top: auto; /* Empuja los botones hacia abajo */
      display: flex;
      flex-direction: column;
      gap: 10px;
      padding-top: 20px;
    }

    /* Estilo para tus botones en columna */
    .modal-actions button {
      width: 100%;
      padding: 10px;
      cursor: pointer;
    }
    .centered {
