  <style>
    @import url("https://fonts.googleapis.com/css2?family=Google+Sans:ital,opsz,wght@0,17..18,400..700;1,17..18,400..700&display=swap");
    @font-face {
      font-family: "Montserrat";
      src: url("/Fonts/Montserrat-Regular.ttf") format("truetype");
      font-weight: 200; /* Normal */
      font-style: normal;
      font-display: swap;
    }
    /*@import url("https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&display=swap");*/
    html,
    body {
      margin: 0;
      padding: 0;
      font-family: "Montserrat", sans-serif;
      background-color: #0b0b0b;
      background-image: url("/w5.jpg");
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
      background-attachment: fixed;
      min-height: 100vh;
      color: white;
    }
    .preview-img-slot {
      width: 100%;
      height: 200px;
      background: rgba(255, 255, 255, 0.068);
      border-radius: 8px;
      margin-bottom: 10px;
      box-shadow: 0 0 10px rgb(0, 0, 0);
    }
    .modal-grupo-trabajos h1 {
      font-size: 1.8rem;
    }
    .hidden {
      display: none !important;
    }
    .modal-grupo-trabajos {
      /* Reseteo para quitar estilos por defecto del navegador */
      margin: 0;
      padding: 20px;
      border: 1px solid #ab2ef3;

      /* Centrado forzado */
      position: fixed;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);

      /* Tamaño y forma */
      width: 50%;
      max-width: 300px;
      max-height: 80vh;
      border-radius: 12px;
      background: #1a1a1a;
      color: white;
      z-index: 99999;
      text-align: center;

      /* Importante: para que sea interactuable */
      display: flex;
      flex-direction: column;
    }

    /* Oscurece el fondo cuando se abre */
    .modal-grupo-trabajos::backdrop {
      background: rgba(0, 0, 0, 0.8);
    }

    .modal-content {
      display: flex;
      flex-direction: column;
      height: 100%;
    }

    .modal-actions {
      margin-top: auto; /* Empuja los botones hacia abajo */
      display: flex;
      flex-direction: column;
      gap: 10px;
      padding-top: 20px;
    }

    /* Estilo para tus botones en columna */
    .modal-actions button {
      width: 100%;
      padding: 10px;
      cursor: pointer;
    }
    .centered {
      display: flex;
      flex-direction: column;
      margin: 0 auto;
      text-align: center;
      padding: 20px;
      /*background: rgba(204, 21, 21, 0.5);*/
    }
    .centered-button-content {
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: center;
      size: 9.2rem;
    }
    /* boton al a parte inferior de la card siempre*/
    .show-btn-mdl {
      text-decoration: none;
      font-family: "Google Sans", sans-serif;
      font-size: 1rem;
      width: 85%;
      background: transparent;
      color: white;
      border: 1px solid rgba(172, 172, 172, 0.404);
      padding: 10px 20px;
      border-radius: 5px;
      cursor: pointer;
      margin-top: auto;
      display: flex;
      align-items: center; /* Alinea verticalmente */
      justify-content: center; /* Alinea horizontalmente */
      gap: 8px;
      &:hover {
        background: rgb(160, 43, 140);
        border: none;
        color: #ffffff;
        transition: all 0.3s ease;
      }
    }
    .work-card h1 {
      color: #ab2ef3;
      font-weight: 400;
      font-size: 19px;
      margin-top: 0;
    }
    .work-card p {
      word-break: break-word;
      margin-bottom: 15px;
      overflow-y: auto;
      flex-grow: 1;
      /* Estilo para el scrollbar opcional para que se vea mejor */
      &::-webkit-scrollbar {
        width: 4px;
      }
      &::-webkit-scrollbar-thumb {
        background: rgba(171, 46, 243, 0.3);
        border-radius: 10px;
      }
    }
    .work-card-photo-slot {
      width: 100%;
      height: 180px;
      background: rgba(255, 255, 255, 0.068);
      border-radius: 8px;
      margin-bottom: 10px;
      box-shadow: 0 0 10px rgb(0, 0, 0);
      flex-shrink: 0;
    }
    h1 {
      animation: fadeInUp 1s ease-out forwards;
      color: #ab2ef3;
      font-weight: 300;
      font-size: 3.5rem;
    }
    p {
      animation: fadeInUp 1s ease-out forwards;
    }
    @keyframes fadeInUp {
      from {
        opacity: 0;
      }
      to {
        opacity: 1;
      }
    }
    .work-card {
      border: 1px solid rgba(171, 46, 243, 0.3);
      background: rgba(255, 255, 255, 0.068);
      border-radius: 8px;
      padding: 15px;
      color: #e0e0e0;
      font-weight: 300;
      width: 18rem;
      height: 400px;
      box-shadow: 0 0 10px rgb(0, 0, 0);
      cursor: pointer;
      display: flex;
      flex-direction: column;
    }
    .work-card p {
      font-size: 0.9rem;
      /* Estilo para el scrollbar opcional para que se vea mejor */
    }
    .submodule-card {
      background: rgba(255, 255, 255, 0.068);
      border-radius: 8px;
      padding: 20px;
      margin: 20px auto;
      max-width: 90%;
      backdrop-filter: blur(10px);
      box-shadow: 0 0 10px rgb(0, 0, 0);
      text-align: center;
    }
    .submodule-card h2 {
      margin-top: 0;
      color: #ab2ef3;
      font-weight: 400;
    }
    .submodule-card p {
      color: #e0e0e0;
      font-weight: 300;
    }
    .works-cointainer {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 20px;
      margin-top: 20px;
    }
    @media (max-width: 768px) {
      h1 {
        font-size: 2.5rem;
      }
      .submodule-card {
        padding: 15px;
        margin: 15px auto;
        width: 350px;
      }
    }
  </style>
</html>
